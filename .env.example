# ========================
# CampConnect Environment Variables
# ========================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/campconnectdb

# ---------- JWT ----------
JWT_SECRET=your-jwt-secret-key-here-minimum-64-characters-long
JWT_EXPIRATION_MS=86400000

# ---------- Server ----------
SERVER_PORT=8090

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-your-openai-api-key-here

# ---------- OpenRouteService ----------
ORS_API_KEY=your-openrouteservice-api-key-here

# ---------- ML Services ----------
ML_DEMAND_URL=http://localhost:5000
ML_GEAR_URL=http://localhost:5001

# ---------- Delivery ----------
DELIVERY_PROVIDER_EMAIL=delivery@mail.com
